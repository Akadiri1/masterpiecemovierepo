4FKA3j7TKSL8uP.jpg","season_number":5,"vote_average":7.8},{"air_date":"2010-06-24","episode_count":26,"id":1873,"name":"Season 6","overview":"","poster_path":"/9QGsYuRe7XHa9ARu9XHKz0h0cra.jpg","season_number":6,"vote_average":7.3},{"air_date":"2012-06-20","episode_count":26,"id":1875,"name":"Season 7","overview":"","poster_path":"/sKkMifpyEHPqqfMsmkOJ7oFgfpb.jpg","season_number":7,"vote_average":7.3},{"air_date":"2023-07-24","episode_count":10,"id":339563,"name":"Season 8","overview":"After a brief ten-year hiatus, Futurama has crawled triumphantly from the cryogenic tube, its full original cast and satirical spirit intact. New viewers will be able to pick up the series from here, while long-time fans will recognize payoffs to decades-long mysteries - including developments in the epic love story of Fry and Leela, the mysterious contents of Nibbler's litter box, the secret history of evil Robot Santa, and the whereabouts of Kif and Amy's tadpoles. Meanwhile there's a whole new pandemic in town as the crew explores the future of vaccines, bitcoin, cancel culture, and streaming TV.","poster_path":"/7bRHBrmSn5QLY1UJ32v4jeSoKzP.jpg","season_number":8,"vote_average":6.5},{"air_date":"2024-07-29","episode_count":10,"id":387123,"name":"Season 9","overview":"On this orbit around the sun, our occasionally heroic crew embarks on mind-bending adventures involving birthday party games to the death, the secrets of Bender's ancestral robot village, A.I. friends (and enemies), impossibly cute beanbags, and the true 5 million-year-old story behind the consciousness-altering substance known as coffee. And, of course, the next chapter in Fry and Leela's fateful, time-twisted romance.","poster_path":"/sdJcX2cXirwQurLLlrDLYov7hcD.jpg","season_number":9,"vote_average":6.5},{"air_date":"2025-09-15","episode_count":10,"id":466354,"name":"Season 10","overview":"Bender is rampaging out of control! A volcano is about to explode! Fry confronts a rival for Leela's love! And Dr. Zoidberg is rising up to heaven?! The excitement might be too much! You've been warned... it's an all new season of FUTURAMA!","poster_path":"/6ZS8SOno6kTmWz4eQ8lX8EBXOMv.jpg","season_number":10,"vote_average":6.7},{"air_date":"2026-08-03","episode_count":10,"id":516338,"name":"Season 11","overview":"Brace yourselves... The future is about to get a whole lot stranger! It's a non-stop onslaught of swaggering space pirates, lab-grown meats, sexy scams... plus the shocking return of Dr. Zoidberg's lost love! You didn't see that coming, prior to being told about it just now!","poster_path":"/1vFaNoZkjjTHdAiVoC6HKhh1Ygz.jpg","season_number":11,"vote_average":6.5}],"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Returning Series","tagline":"New season on the horizon.","type":"Scripted","vote_average":8.4,"vote_count":3903,"credits":{"cast":[{"adult":false,"gender":2,"id":23679,"known_for_department":"Acting","name":"Billy West","original_name":"Billy West","popularity":1.1962,"profile_path":"/iNQtBsgV4wr3z5CEEFhR5U4Yedk.jpg","character":"Fry / Professor Farnsworth / Zoidberg / Zapp Brannigan (voice)","credit_id":"52538ac919c2957940246ba6","order":0},{"adult":false,"gender":1,"id":18980,"known_for_department":"Acting","name":"Katey Sagal","original_name":"Katey Sagal","popularity":2.5266,"profile_path":"/jdnBWdXlQG2Q2F6v9MPJkaWQ9Vd.jpg","character":"Leela (voice)","credit_id":"52538ac919c2957940246c16","order":1},{"adult":false,"gender":2,"id":31531,"known_for_department":"Acting","name":"John DiMaggio","original_name":"John DiMaggio","popularity":2.7685,"profile_path":"/qcbQe71nSlULDsP1OxTqltEKFbl.jpg","character":"Bender (voice)","credit_id":"52538ac919c2957940246bde","order":2},{"adult":false,"gender":1,"id":34983,"known_for_department":"Acting","name":"Tress MacNeille","original_name":"Tress MacNeille","popularity":1.5841,"profile_path":"/gI2LsgByvSffQY34vabVnPmrHzw.jpg","character":"Mom (voice)","credit_id":"52538aca19c295